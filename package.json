{
  "name": "expert-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke:setup": "npm run smoke:setup:staging",
    "smoke:setup:dry": "npm run smoke:setup:staging -- --dry-run",
    "smoke:setup:staging": "node scripts/operationalSmokeSetup.mjs --staging",
    "smoke:roles": "tsx scripts/roleRedirectSmoke.ts",
    "qa:seed-users": "npm run qa:seed-users:staging",
    "qa:seed-users:staging": "node scripts/seed-qa-users.mjs --staging",
    "test:rules": "npm run test:rules:collection-groups",
    "test:rules:collection-groups": "firebase emulators:exec --only firestore \"tsx scripts/firestoreCollectionGroupRules.test.ts\"",
    "seed:prescriptors": "npm run seed:prescriptors:staging",
    "seed:prescriptors:staging": "node scripts/seedPrescriptors.mjs --staging",
    "backfill:date-fields": "node scripts/backfillDateFields.mjs",
    "backfill:mentor-assignments": "npm run backfill:mentor-assignments:staging --",
    "backfill:mentor-assignments:staging": "node scripts/backfillMentorAssignments.mjs --staging"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "framer-motion": "^11.12.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "firebase-tools": "^15.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
